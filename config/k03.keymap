#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
        ryaq: ryaq { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_YA>, <&kp Q>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rzhw: rzhw { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_ZHE>, <&kp W>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        reff: reff { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_EF>, <&kp F>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rpep: rpep { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_PE>, <&kp P>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rbeb: rbeb { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_BE>, <&kp B>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rsij: rsij { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_SHORT_I>, <&kp J>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rell: rell { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_EL>, <&kp L>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        ruuu: ruuu { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_U>, <&kp U>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rery: rery { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_YERU>, <&kp Y>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        ryus: ryus { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_YU>, <&kp SEMI>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rshb: rshb { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_SHA>, <&kp BSLH>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        raaa: raaa { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_A>, <&kp A>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rerr: rerr { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_ER>, <&kp R>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        ress: ress { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_ES>, <&kp S>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rtet: rtet { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_TE>, <&kp T>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rghg: rghg { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_GHE>, <&kp G>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        remm: remm { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_EM>, <&kp M>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        renn: renn { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_EN>, <&kp N>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        riee: riee { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_IE>, <&kp E>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        riii: riii { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_I>, <&kp I>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rooo: rooo { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_O>, <&kp O>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rssq: rssq { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_SOFT_SIGN>, <&kp SQT>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rzez: rzez { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_ZE>, <&kp Z>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rhax: rhax { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_HA>, <&kp X>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rtsc: rtsc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_TSE>, <&kp C>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rded: rded { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_DE>, <&kp D>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rvev: rvev { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_VE>, <&kp V>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rshl: rshl { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_SHCHA>, <&kp LBKT>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rhrb: rhrb { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_HARD_SIGN>, <&kp RBKT>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rkak: rkak { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_KA>, <&kp K>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rchh: rchh { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_CHE>, <&kp H>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rcom: rcom { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_COMMA>, <&kp COMMA>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        rdot: rdot { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_DOT>, <&kp DOT>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
        refsl: refsl { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RU_CYRILLIC_E>, <&kp FSLH>; mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>; };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <15 16>;
            layers = <0>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&kp LCTRL>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_release>,
                <&kp LSHFT>,
                <&kp LCTRL>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &to 0>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_ru &to 1>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                          &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
&kp ESC    &kp Q   &kp W     &kp F     &kp P      &kp B                           &kp J   &kp L      &kp U      &kp Y     &kp SEMI  &kp BSLH
&kp TAB    &kp A   &kp R     &kp S     &kp T      &kp G                           &kp M   &kp N      &kp E      &kp I     &kp O     &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp D      &kp V   &kp LBKT     &kp RBKT   &kp K   &kp H      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL  &mo 2   &kp SPACE    &kp ENTER  &mo 3   &kp RCTRL  &kp RALT   &kp RGUI
            >;

            display-name = "Base";
            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp RU_CYRILLIC_IO  &kp N1                   &kp N2                &kp N3               &kp N4              &kp N5                                                               &kp N6                   &kp N7                    &kp N8              &kp N9                 &kp N0               &kp BSPC
&kp ESC    &ryaq                 &rzhw             &reff             &rpep            &rbeb                                                           &rsij            &rell                  &ruuu            &rery             &ryus         &rshb
&kp TAB    &raaa                  &rerr              &ress             &rtet            &rghg                                                          &remm                 &renn                  &riee           &riii                &rooo             &rssq
&kp LSHFT  &rzez                 &rhax              &rtsc            &rded            &rvev        &rshl             &rhrb              &rkak                 &rchh                 &rcom    &rdot           &refsl          &kp RSHFT
                                    &kp LGUI              &kp LALT             &kp LCTRL           &mo 2               &kp SPACE             &kp ENTER                  &mo 4                    &kp RCTRL                 &kp RALT            &kp RGUI
            >;

            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        nav {
            bindings = <
&kp F1  &kp F2  &kp F3        &kp F4    &kp F5         &kp F6                     &kp F7           &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &kp HOME      &kp UP    &kp END        &kp INS                    &kp PG_UP        &kp N7  &kp N8  &kp N9   &trans   &trans
&trans  &trans  &kp LEFT      &kp DOWN  &kp RIGHT      &kp RET                    &kp PG_DN        &kp N4  &kp N5  &kp N6   &trans   &trans
&trans  &trans  &kp LC(LEFT)  &kp CAPS  &kp LC(RIGHT)  &kp DEL  &trans    &trans  &kp PRINTSCREEN  &kp N1  &kp N2  &kp N3   &trans   &trans
                &trans        &trans    &trans         &trans   &trans    &trans  &mo 5            &trans  &kp N0  &trans
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&trans  &trans     &kp AT    &kp DLLR   &kp HASH  &trans                       &trans     &trans    &kp CARET  &trans    &trans    &trans
&trans  &trans     &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &trans     &kp LBKT  &kp UNDER  &kp RBKT  &trans    &trans
&trans  &kp BSLH   &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &kp QUESTION
&trans  &kp COMMA  &kp STAR  &kp COLON  &kp FSLH  &trans     &trans    &trans  &trans     &kp PIPE  &kp TILDE  &kp AMPS  &kp DOT   &trans
                   &trans    &trans     &trans    &mo 5      &trans    &trans  &trans     &trans    &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&trans  &trans        &en AT        &en DLLR      &en HASH     &trans                           &trans          &trans    &en CARET    &trans    &trans      &trans
&trans  &trans        &en LT        &kp EQUAL     &en GT       &en GRAVE                        &trans          &en LBKT  &kp UNDER    &en RBKT  &trans      &trans
&trans  &kp RU_BSLH   &kp LPAR      &kp MINUS     &kp RPAR     &kp PLUS                         &kp RU_PERCENT  &en LBRC  &kp RU_SEMI  &en RBRC  &kp EXCL    &kp RU_QUESTION
&trans  &kp RU_COMMA  &kp RU_ASTRK  &kp RU_COLON  &kp RU_FSLH  &kp RU_NUMERO  &trans    &trans  &trans          &en PIPE  &en TILDE    &en AMPS  &kp RU_DOT  &trans
                      &trans        &trans        &trans       &mo 5          &trans    &trans  &trans          &trans    &trans       &trans
            >;
        };

        adj {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans            &trans        &trans        &studio_unlock
&trans       &trans  &trans  &trans  &trans  &trans                    &out OUT_BLE  &kp C_VOL_DN  &kp K_MUTE        &kp C_VOL_UP  &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans    &trans  &out OUT_USB  &kp K_PREV    &kp K_PLAY_PAUSE  &kp K_NEXT    &tog 6        &trans
                     &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans            &trans
            >;

            display-name = "Adjust";
        };
        game {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &kp N6  &kp N7    &kp N8     &kp N9     &kp N0     &kp BSPC
&kp ESC    &kp Q   &kp W   &kp E   &kp R   &kp T                     &kp Y   &kp U     &kp I      &kp O      &kp P      &kp BSLH
&kp TAB    &kp A   &kp S   &kp D   &kp F   &kp G                     &kp H   &kp J     &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp LBKT  &kp RBKT  &kp N   &kp M     &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL  &mo 2   &kp SPACE   &kp ENTER  &mo 5   &kp RCTRL  &kp RALT   &kp RGUI
            >;

            display-name = "Game";
        };
    };
};
